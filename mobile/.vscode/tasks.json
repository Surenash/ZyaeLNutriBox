{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "npm: install",
      "type": "shell",
      "command": "npm install",
      "problemMatcher": [],
      "group": "build",
      "presentation": {
        "reveal": "always"
      },
      "options": {
        "cwd": "${workspaceFolder}"
      }
    },
    {
      "label": "npm: start",
      "type": "shell",
      "command": "npm start",
      "problemMatcher": [],
      "group": "build",
      "presentation": {
        "reveal": "always"
      },
      "options": {
        "cwd": "${workspaceFolder}"
      }
    },
    {
      "label": "expo: start",
      "type": "shell",
      "command": "npx expo start --port 8084",
      "problemMatcher": [],
      "group": "build",
      "presentation": {
        "reveal": "always"
      },
      "options": {
        "cwd": "${workspaceFolder}"
      }
    },
    {
      "label": "expo: start (clear cache)",
      "type": "shell",
      "command": "npx expo start --port 8084 --clear",
      "problemMatcher": [],
      "group": "build",
      "presentation": {
        "reveal": "always"
      },
      "options": {
        "cwd": "${workspaceFolder}"
      }
    }
  ]
}
